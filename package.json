{
  "name": "xlsx-now",
  "version": "0.5.0",
  "description": "PoC: isomorphic (Node + browser) streaming XLSX writer with cell styles, number/date formats and formulas, and a reader for the data",
  "type": "module",
  "license": "MIT",
  "repository": "ari-dc-uba-ar/xlsx-now",
  "exports": {
    ".": {
      "types": "./dist/src/core/index.d.ts",
      "default": "./dist/src/core/index.js"
    },
    "./node": {
      "types": "./dist/src/node/index.d.ts",
      "default": "./dist/src/node/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser/index.d.ts",
      "default": "./dist/src/browser/index.js"
    },
    "./umd": {
      "types": "./dist/src/core/index.d.ts",
      "default": "./dist/umd/xlsx-now.umd.js"
    },
    "./umd/browser": {
      "types": "./dist/src/browser/index.d.ts",
      "default": "./dist/umd/xlsx-now-browser.umd.js"
    },
    "./dist/umd/xlsx-now.umd.js": "./dist/umd/xlsx-now.umd.js",
    "./dist/umd/xlsx-now-browser.umd.js": "./dist/umd/xlsx-now-browser.umd.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/src/core/index.d.ts",
  "unpkg": "./dist/umd/xlsx-now.umd.js",
  "jsdelivr": "./dist/umd/xlsx-now.umd.js",
  "files": [
    "dist/src",
    "dist/umd",
    "src"
  ],
  "scripts": {
    "build": "tsc && npm run build:umd",
    "build:umd": "rollup -c",
    "typecheck": "tsc --noEmit",
    "build:test": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "npm run build:test && mocha",
    "test-ci": "npm run build:test && c8 mocha",
    "benchmark": "npm run build && node dist/examples/node/benchmark.js",
    "validate": "npm run build && node dist/scripts/validate-xlsx.js",
    "example:node": "npm run build && node dist/examples/node/write-file.js",
    "example:browser": "npm run build && node dist/examples/browser/serve.js",
    "example:browser:test": "npm run build && node dist/examples/browser/run-in-chromium-test.js",
    "example:umd:node": "npm run build && node examples/umd/require.cjs",
    "example:umd:browser": "npm run build && node dist/examples/browser/serve.js",
    "example:umd:browser:test": "npm run build && PAGE_PATH=/examples/umd/index.html OUT_FILE=out/example-umd-browser.xlsx node dist/examples/browser/run-in-chromium-test.js"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "c8": "^12.0.0",
    "exceljs": "^4.4.0",
    "mocha": "^12.0.3",
    "playwright-core": "^1.65.0",
    "qa-control": "^0.15.0",
    "rollup": "^4.68.0",
    "server4test": "^2.1.2",
    "temporal-polyfill": "^1.0.8",
    "typescript": "^5.9.3",
    "yauzl": "^3.4.0",
    "typescript-eslint": "^8.72.1"
  },
  "qa-control": {
    "run-in": "both",
    "type": "lib",
    "gha": "all",
    "multilang": "no",
    "test-appveyor": true,
    "fileNameMainDoc": "README.md",
    "silenced": [
      "packagejson_main_file_1_does_not_exists",
      "invalid_files_section_in_package_json",
      "eslint_errors_in_file_1"
    ]
  }
}
